# Unity .gitattributes

# ---------------------------------------------------------------
# Macros
# ---------------------------------------------------------------
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# ---------------------------------------------------------------
# Todo binario nuevo que uses debe agregarse abajo como lfs/binary
# ---------------------------------------------------------------
* text=auto

# ---------------------------------------------------------------
# Codigo y texto explicitos
# ---------------------------------------------------------------
*.cs                    text diff=csharp eol=lf
*.cginc                 text eol=lf
*.compute               text linguist-language=hlsl eol=lf
*.hlsl                  text linguist-language=hlsl eol=lf
*.shader                text eol=lf
*.json                  text eol=lf
*.wlt                   text eol=lf
*.conf                  text eol=lf
*.md                    text eol=lf
*.txt                   text eol=lf

# Scripts de shell
*.bat                   text eol=crlf
*.cmd                   text eol=crlf
*.sh                    text eol=lf

# ---------------------------------------------------------------
# JSON / UI Toolkit de Unity
# ---------------------------------------------------------------
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml

# ---------------------------------------------------------------
# YAML de Unity
# ---------------------------------------------------------------
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml
*.vfx                   unity-yaml
*.vfxoperator           unity-yaml
*.vfxblock              unity-yaml

# ---------------------------------------------------------------
# EXCEPCIONES de .asset: binarios o pesados (DEBEN ir despues de *.asset)
# lfs incluye -text, asi Git NUNCA toca los saltos de linea.
# Ajusta la ruta si tus terrenos NO estan en Assets/Terrains/
# ---------------------------------------------------------------
Assets/Terrains/**/*.asset   lfs
NavMesh*.asset               lfs
OcclusionCullingData.asset   lfs
LightingData.asset           lfs
*.raw                        binary

# ---------------------------------------------------------------
# Binarios que no deben pasar por la heuristica text=auto
# ---------------------------------------------------------------
*.bytes                 binary
*.bank                  binary

# ---------------------------------------------------------------
# Archivos pesados gestionados por Git LFS
# (se quitaron *.unitypackage, *.apk, *.blend1 y *.pdb porque
#  estan en .gitignore y se contradecian)
