# Unity .gitignore

# ---------------------------------------------------------------
# Carpetas temporales y de cache de Unity
# ---------------------------------------------------------------
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Backups de escenas que Unity guarda tras un crash
/[Aa]ssets/_Recovery*
InitTestScene*.unity*

# ---------------------------------------------------------------
# Blender
# ---------------------------------------------------------------
*.blend1
*.blend1.meta

# ---------------------------------------------------------------
# Capturas de memoria y grabaciones
# ---------------------------------------------------------------
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ---------------------------------------------------------------
# Autogenerados de IDEs (Visual Studio, VS Code, Rider)
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.DotSettings.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
/[Aa]ssets/Plugins/Editor/JetBrains*

# Metas huerfanos de archivos ignorados
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------
# Reportes de errores, pruebas y builds
# ---------------------------------------------------------------
sysinfo.txt
mono_crash.*
*.stackdump
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Compilacion temporal de Burst
/*_BurstDebugInformation_DoNotShip/

# ---------------------------------------------------------------
# Cache de Addressables y Visual Scripting
# ---------------------------------------------------------------
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Unity.VisualScripting.Generated/
/[Aa]ssets/[Ss]ceneDependencyCache*

# ---------------------------------------------------------------
# Windows
# ---------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/